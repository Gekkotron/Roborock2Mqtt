# Roborock vacuum
VACUUM_IP=192.168.1.200
VACUUM_TOKEN=replace-with-your-token

# MQTT broker
BROKER_IP=192.168.1.90
BROKER_PORT=1883
# BROKER_USERNAME=
# BROKER_PASSWORD=

# Topic prefix (default: roborock)
TOPIC_PREFIX=roborock

# miiocli device subcommand (roborockvacuum, dreamevacuum, viomivacuum, g1vacuum, ...)
MIIO_DEVICE=roborockvacuum

# Intervals in seconds
STATUS_INTERVAL=600
CONSUMABLE_INTERVAL=86400
ALIVE_INTERVAL=240

# Home Assistant MQTT discovery
# HA_DISCOVERY_ENABLED=false
# HA_DISCOVERY_PREFIX=homeassistant
# HA_STATUS_INTERVAL=30

# Logging
LOG_LEVEL=INFO
